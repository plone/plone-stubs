def queryUtility[T](
    interface: type[T], name: str = ..., default: T | None = ..., context: Any = ...
) -> T | None: ...
def getAdapter[T](
    object: Any, interface: type[T], name: str = ..., context: Any = ...
) -> T: ...
def queryAdapter[T](
    object: Any,
    interface: type[T],
    name: str = ...,
    default: T | None = ...,
    context: Any = ...,
