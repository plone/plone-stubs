class IRegistry(Interface):
    def registrations(self) -> Iterator[Any]: ...

class IComponentRegistrationConvenience(Interface):
    def provideUtility(
        self, component: Any, provides: Any = ..., name: str = ...
    ) -> None: ...
    def provideAdapter(
        self, factory: Any, adapts: Any = ..., provides: Any = ..., name: str = ...
    ) -> None: ...
    def provideSubscriptionAdapter(
        self, factory: Any, adapts: Any = ..., provides: Any = ...
    ) -> None: ...
    def provideHandler(self, handler: Any, adapts: Any = ...) -> None: ...

class IPossibleSite(Interface):
    def setSiteManager(self, sitemanager: IComponentLookup) -> None: ...
    def getSiteManager(self) -> IComponentLookup: ...

class ISite(IPossibleSite):
    """A site that holds a local component registry."""

class IFactory(Interface):
    title: str
    description: str

    def __call__(self, *args: Any, **kw: Any) -> Any: ...
    def getInterfaces(self) -> Any: ...

class IObjectEvent(Interface):
    object: Any

class IRegistered(IObjectEvent): ...
class IUnregistered(IObjectEvent): ...
class Invalid(Exception): ...
class ComponentLookupError(Exception): ...
class Misused(Exception): ...
