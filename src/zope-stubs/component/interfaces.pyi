"""Partial stubs for :mod:`zope.component.interfaces`.

Signatures mirror the runtime interfaces. Lookup methods that take an
interface and return a provider are typed generically so that, e.g.,
``getSiteManager().getUtility(IFoo)`` is inferred as ``IFoo``.
"""

from collections.abc import Iterator
from typing import Any
from zope.interface import Interface

class IComponentLookup(Interface):
    """A component registry — the object returned by ``getSiteManager()``."""

    adapters: Any
    utilities: Any

    def queryAdapter[T](
        self, object: Any, interface: type[T], name: str = ..., default: Any = ...
    ) -> T | None: ...
    def getAdapter[T](self, object: Any, interface: type[T], name: str = ...) -> T: ...
    def queryMultiAdapter[T](
        self,
        objects: tuple[Any, ...],
        interface: type[T],
        name: str = ...,
        default: Any = ...,
    ) -> T | None: ...
    def getMultiAdapter[T](
        self, objects: tuple[Any, ...], interface: type[T], name: str = ...
    ) -> T: ...
    def getAdapters(
        self, objects: tuple[Any, ...], provided: Any
    ) -> Iterator[tuple[str, Any]]: ...
    def subscribers(self, objects: tuple[Any, ...], provided: Any) -> list[Any]: ...
    def handle(self, *objects: Any) -> None: ...
    def queryUtility[T](
        self, interface: type[T], name: str = ..., default: Any = ...
    ) -> T | None: ...
    def getUtilitiesFor[T](self, interface: type[T]) -> Iterator[tuple[str, T]]: ...
    def getAllUtilitiesRegisteredFor[T](self, interface: type[T]) -> Iterator[T]: ...

class IComponentRegistry(Interface):
    def registerUtility(
        self,
        component: Any = ...,
        provided: Any = ...,
        name: str = ...,
        info: str = ...,
        factory: Any = ...,
    ) -> None: ...
    def unregisterUtility(
        self,
        component: Any = ...,
        provided: Any = ...,
        name: str = ...,
        factory: Any = ...,
    ) -> bool: ...
    def registerAdapter(
        self,
        factory: Any,
        required: Any = ...,
        provided: Any = ...,
        name: str = ...,
        info: str = ...,
    ) -> None: ...
    def unregisterAdapter(
        self,
        factory: Any = ...,
        required: Any = ...,
        provided: Any = ...,
        name: str = ...,
    ) -> bool: ...
    def registerHandler(
        self, handler: Any, required: Any = ..., info: str = ...
    ) -> None: ...
    def unregisterHandler(self, handler: Any = ..., required: Any = ...) -> bool: ...

class IComponents(IComponentLookup, IComponentRegistry):
    """A registry providing both lookup and registration."""

